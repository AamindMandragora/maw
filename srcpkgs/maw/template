# Template file for 'maw'
pkgname=maw
version=0.2.2
revision=1
build_style=cargo
depends="nix git xbps"
short_desc="Declarative system manager for Void Linux"
maintainer="Advayth Pashupati <advaythp@gmail.com>"
license="MIT"
homepage="https://github.com/AamindMandragora/maw"
distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz"
checksum=cfefc463edb8e7aea7f47e461f7bb082ad819b2d32a9fce1c0ed158c46274fb8

# maw reads its nix lib and shipped registry from /usr/share/maw
post_install() {
	vmkdir usr/share/maw
	vcopy nix usr/share/maw
	vinstall registry.nix 644 usr/share/maw
	vinstall depmap.nix 644 usr/share/maw
	vlicense LICENSE
	vcompletion completions/maw.bash bash
	vcompletion completions/_maw zsh
	vcompletion completions/maw.fish fish
	for page in man/*; do
		vman "$page"
	done
}

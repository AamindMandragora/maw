enabled = true
extra = "verbatim"
ratio = 0.5
title = "greetd"

[default_session]
command = "tuigreet --cmd niri-session"
user = "greeter"

["key with space".inline]
a = 1

[servers.alpha]
ip = "10.0.0.1"
ports = [80, 443]

[terminal]
vt = 1

[[bin]]
name = "maw"
path = "src/main.rs"

[[bin]]
name = "tool"

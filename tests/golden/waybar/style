* {
  font-family: "Adwaita Sans", "JetBrainsMono Nerd Font", sans-serif;
  font-size: 13px;
  font-weight: 500;
  margin: 0;
  min-height: 0;
  padding: 0px 3px;
}

button {
  background: transparent;
  border: none;
  box-shadow: none;
}

tooltip {
  background: rgba(28, 28, 30, 0.92);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #f2f2f7;
  font-size: 12px;
  padding: 6px 10px;
}

tooltip label {
  color: #f2f2f7;
}

window#waybar {
  background: rgba(0, 0, 0, 0.9);
  color: #f2f2f7;
  padding: 2px 8px;
}

#clock,
#battery,
#cpu,
#memory,
#network,
#bluetooth,
#wireplumber,
#backlight,
#mpris,
#custom-off {
  color: #bababf;
  font-size: 12px;
  font-weight: 500;
  margin: 4px 0px;
  padding: 4px 9px;
  transition: background 0.15s ease, color 0.15s ease;
}

#clock {
  color: #f2f2f7;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.2px;
  padding: 4px 11px;
}

#mpris.playing {
  color: #f2f2f7;
}

#workspaces {
  margin: 0 6px;
}

#workspaces button {
  color: rgba(255, 255, 255, 0.25);
  font-size: 10px;
  margin: 4px 1px;
  padding: 4px 8px;
  transition: all 0.15s ease;
}

#workspaces button.active {
  background: rgba(255, 255, 255, 0.14);
  color: #f2f2f7;
}

#workspaces button:hover {
  background: rgba(255, 255, 255, 0.07);
  color: #f2f2f7;
}

#network.disconnected,
#bluetooth.off,
#bluetooth.disabled,
#wireplumber.muted {
  color: rgba(255, 255, 255, 0.28);
}

#battery.charging {
  color: #7fd88f;
}

#battery.critical:not(.charging) {
  animation: pulse 1.5s ease-in-out infinite;
  color: #ff6961;
}

#battery.warning:not(.charging) {
  color: #f5c76a;
}

@keyframes pulse {
  0% {
    opacity: 1;
  }

  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.5;
  }
}

#group-device,
#group-internet,
#group-waves {
  padding: 0;
}

#pulseaudio-slider,
#backlight-slider {
  margin: 4px 0;
  padding: 0 4px;
}

#pulseaudio-slider trough,
#backlight-slider trough {
  background: rgba(255, 255, 255, 0.09);
  min-height: 6px;
  min-width: 72px;
}

#pulseaudio-slider highlight,
#backlight-slider highlight {
  background: rgba(255, 255, 255, 0.5);
  border-radius: 3px;
  min-width: 6px;
}

#pulseaudio-slider slider,
#backlight-slider slider {
  background-image: none;
  border: none;
  box-shadow: none;
  min-height: 0;
  min-width: 0;
  opacity: 0;
}

#network:hover,
#bluetooth:hover,
#wireplumber:hover,
#backlight:hover,
#battery:hover,
#cpu:hover,
#memory:hover,
#custom-off:hover {
  background: rgba(255, 255, 255, 0.07);
  color: #f2f2f7;
}

#calendar {
  color: #8e8e93;
  font-size: 12px;
}

#calendar.header {
  color: #f2f2f7;
  font-weight: 600;
}

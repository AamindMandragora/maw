        set-column-width "+10%"
    }
    Mod+F {
        maximize-column
    }
    Mod+L {
        spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"
    }
    Mod+Left {
        focus-column-or-monitor-left
    }
    Mod+Minus {
        set-column-width "-10%"
    }
    Mod+O repeat=false {
        toggle-overview
    }
    Mod+Period {
        spawn "emote"
    }
    Mod+Q repeat=false {
        close-window
    }
    Mod+R {
        switch-preset-column-width
    }
    Mod+Right {
        focus-column-or-monitor-right
    }
    Mod+S {
        screenshot
    }
    Mod+Shift+A {
        switch-focus-between-floating-and-tiling
    }
    Mod+Shift+Down {
        move-column-to-monitor-down
    }
    Mod+Shift+Equal {
        set-window-height "+10%"
    }
    Mod+Shift+F {
        fullscreen-window
    }
    Mod+Shift+Left {
        move-column-to-monitor-left
    }
    Mod+Shift+Minus {
        set-window-height "-10%"
    }
    Mod+Shift+R {
        spawn "sh" "-c" "GEOM=$(slurp) && REGION=$(echo \"$GEOM\" | awk -F'[ ,x]' '{print $3\"x\"$4\"+\"$1\"+\"$2}') && gpu-screen-recorder -encoder cpu -w region -region \"$REGION\" -a default_output -f 60 -o ~/Videos/Captures/$(date +%Y-%m-%d_%H-%M-%S).mp4"
    }
    Mod+Shift+Right {
        move-column-to-monitor-right
    }
    Mod+Shift+S {
        screenshot-window
    }
    Mod+Shift+Slash {
        show-hotkey-overlay
    }
    Mod+Shift+Up {
        move-column-to-monitor-up
    }
    Mod+Shift+WheelScrollDown {
        focus-column-or-monitor-right
    }
    Mod+Shift+WheelScrollUp {
        focus-column-or-monitor-left
    }
    Mod+Space hotkey-overlay-title="fuzzel" {
        spawn "fuzzel"
    }
    Mod+T hotkey-overlay-title="ghostty" {
        spawn "ghostty"
    }
    Mod+Tab {
        focus-workspace-previous
    }
    Mod+TouchpadScrollDown {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+ -l 1.0"
    }
    Mod+TouchpadScrollUp {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"
    }
    Mod+Up {
        focus-window-or-workspace-up
    }
    Mod+V {
        spawn "vivaldi-stable"
    }
    Mod+W {
        toggle-column-tabbed-display
    }
    Mod+WheelScrollDown cooldown-ms=200 {
        focus-window-or-workspace-down
    }
    Mod+WheelScrollUp cooldown-ms=200 {
        focus-window-or-workspace-up
    }
    XF86AudioLowerVolume {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"
    }
    XF86AudioMicMute {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    }
    XF86AudioMute {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }
    XF86AudioNext {
        spawn-sh "playerctl next"
    }
    XF86AudioPlay {
        spawn-sh "playerctl play-pause"
    }
    XF86AudioPrev {
        spawn-sh "playerctl previous"
    }
    XF86AudioRaiseVolume {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"
    }
    XF86AudioStop {
        spawn-sh "playerctl stop"
    }
    XF86MonBrightnessDown {
        spawn "brightnessctl" "--class=backlight" "set" "10%-"
    }
    XF86MonBrightnessUp {
        spawn "brightnessctl" "--class=backlight" "set" "+10%"
    }
    XF86PowerOff {
        spawn "~/.local/bin/powermenu"
    }
    XF86WakeUp {
        spawn "true"
    }
}
